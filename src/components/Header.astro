---
import MdiRssBox from "~icons/mdi/rss-box";
import MdiMenu from "~icons/mdi/menu";

const navLinks = [
	{ text: "Archives", href: "/archives" },
	{ text: "Changelog", href: "/changelog" },
	{ text: "Highlights", href: "/special" },
	{
		text: "Travelling",
		href: "https://www.travellings.cn/go.html",
		target: "_blank",
	},
];
---

<div id="header" class="my-5">
	<header>
		<div id="site-meta">
			<div id="site-logo" class="text-4xl text-link">
				<a href="/">
					<span>Imken 发电厂</span>
				</a>
			</div>
			<div id="site-desc" class="mt-2 my-6">你好呀！</div>
		</div>

		<script is:inline>
			function toggleNav() {
				const mobileNav = document.getElementById("mobile-nav");
				mobileNav.classList.toggle("max-md:hidden");
			}
		</script>

		<button
			class="px-2 py-1 bg-gray-200 rounded text-lg md:hidden"
			onclick="toggleNav()"
		>
			<MdiMenu />
		</button>

		<div
			id="mobile-nav"
			class="max-md:fixed max-md:bg-white max-md:border max-md:p-3 max-md:rounded z-50 max-md:hidden"
		>
			<ul id="main-nav" class="flex flex-col md:flex-row md:gap-5 gap-2">
				{
					navLinks.map((link) => (
						<li>
							<a
								class={(Astro.url.pathname === link.href ? "text-white bg-link rounded-md" : "text-link") + " px-2 py-1"}
								href={link.href}
								target={link.target || undefined}
							>
								{link.text}
							</a>
						</li>
					))
				}
				<li class="grow max-md:hidden"></li>
				<li>
					<a
						class="text-link px-2 py-1"
						href="/feed"
						target="_blank"
					>
						<MdiRssBox class="inline" /> RSS
					</a>
				</li>
			</ul>
		</div>

		<hr class="text-gray-200 mt-2" />
	</header>
</div>
